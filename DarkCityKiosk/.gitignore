# Unreal caches and build output (regenerated by the editor)
Unreal/Binaries/
Unreal/DerivedDataCache/
Unreal/Intermediate/
Unreal/Saved/

# Blender autosave/backup files
*.blend1
*.blend2

# Python bytecode
__pycache__/

# Renders: frames, encoded previews and stills (all regenerable, and large)
Renders/
Blender/renders/

# Third-party content: purchased Fab packs and Epic's Starter Content may not be redistributed in
# this public repo. Re-add them from Fab / the editor (Add > Add Feature or Content Pack) when
# cloning: EasyRain, Ultra Dynamic Sky, NPC Animation Pack, Female NPC pack Vol.2, Starter Content.
Unreal/Content/EasyRain/
Unreal/Content/UltraDynamicSky/
Unreal/Content/NPC_Animation_Pack/
Unreal/Content/FemaleNPCpack_2/
Unreal/Content/StarterContent/
Unreal/Content/__ExternalActors__/
Unreal/Content/__ExternalObjects__/
Unreal/EasyRain.png

# Built from the packs' mannequins and animations (setup_outfits.py / setup_crowd.py / export_bodies.py
# regenerate them once the packs are installed)
Unreal/Content/DarkCity/Crowd/Outfits/
Unreal/Content/DarkCity/Crowd/Anims/
Unreal/RawContent/bodies/
Blender/outfits.blend
